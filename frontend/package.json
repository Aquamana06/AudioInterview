    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.65.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
